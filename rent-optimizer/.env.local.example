# Database (Neon)
# Pooled connection — used at runtime in serverless functions
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Unpooled connection — used for drizzle-kit migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Comp scraping — choose one or both
SCRAPERAPI_KEY=...           # Option A: ScraperAPI
RAPIDAPI_KEY=...             # Option B: RapidAPI (Zillow56 or Realty in US)

# Shared secret for cron endpoints (Vercel sets CRON_SECRET automatically in prod)
CRON_SECRET=...
COMP_SCRAPE_SECRET=...
